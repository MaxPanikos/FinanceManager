<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.TextFlow?>
<fx:root type="org.example.financemanager.HomepageView" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" stylesheets="@page-view.css, @homepageview.css">
    <VBox spacing="20.0" styleClass="page">
        <HBox>
            <Label text="Domovská stránka" wrapText="true" styleClass="page-title"/>
        </HBox>
        <FlowPane fx:id="flowPane" hgap="15" vgap="15" VBox.vgrow="ALWAYS">
            <VBox spacing="5" styleClass="homepage-tile">
                <Label text="Statistky" styleClass="title"/>
                <Region minHeight="5" maxHeight="20" VBox.vgrow="ALWAYS"/>
                <TextFlow fx:id="incomeTextFlow"/>
                <TextFlow fx:id="expanseTextFlow"/>
                <TextFlow fx:id="remainingTextFlow"/>
            </VBox>
            <VBox spacing="5" styleClass="homepage-tile">
                <Label text="Přidat rychle transakci" styleClass="title"/>
                <Region minHeight="5" maxHeight="20" VBox.vgrow="ALWAYS"/>
                <Spinner fx:id="spinner" />
                <ComboBox fx:id="comboBox"/>
                <Button text="Přidat" onAction="#addTx" styleClass="button"/>
                <Label fx:id="addTxResponseLabel" styleClass="response-label"/>
            </VBox>
        </FlowPane>
    </VBox>
</fx:root>
