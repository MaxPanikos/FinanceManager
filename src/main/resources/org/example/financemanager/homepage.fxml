<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<fx:root type="org.example.financemanager.HomepageView" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" stylesheets="@page-view.css">
    <VBox spacing="20.0" styleClass="page">
        <HBox>
            <Label text="Domovská stránka" wrapText="true" styleClass="page-title"/>
        </HBox>
        <FlowPane fx:id="flowPane" hgap="15" vgap="15" VBox.vgrow="ALWAYS">
            <VBox fx:id="balanceTile" >
                <Label fx:id="incomeLabel"/>
                <Label fx:id="expenseLabel"/>
                <Label fx:id="remainingLabel"/>
            </VBox>
            <VBox>
                <Label text="Přidat rychle transakci"/>
                <Spinner fx:id="spinner" />
                <ComboBox fx:id="comboBox"/>
                <Button text="Přidat" onAction="#addTx"/>
                <Label fx:id="addTxResponseLabel"/>
            </VBox>
        </FlowPane>
    </VBox>
</fx:root>
